# Настройки выгрузки таблицы monster_data_mart (npm run data:pull).
# Скопируй этот файл в .env.local и заполни. .env.local не попадает в git.
# Не добавляй к этим переменным префикс VITE_: тогда ключ попадёт в сборку игры.

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://<project-ref>.supabase.co/rest/v1/

# Supabase → Project Settings → API Keys → Secret key (sb_secret_...)
# Подойдёт и legacy service_role. Publishable/anon-ключ тоже работает, но только
# при политике RLS на чтение, и без него скрипт не узнает типы колонок.
SUPABASE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
